# Koneksi PostgreSQL (cocok dengan docker-compose.yml)
DATABASE_URL=postgres://postgres:rahasia@127.0.0.1:5432/bengkayang
# Kunci rahasia untuk login admin. Ganti dengan string acak panjang (jangan dibagikan).
PAYLOAD_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG
NEXT_PUBLIC_SITE_NAME=Kabupaten Bengkayang
# Folder penyimpanan file upload (foto/PDF). Pastikan ikut di-backup.
MEDIA_DIR=media
